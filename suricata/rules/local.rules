# ==============================================================================
# Shadow Guard 2.0 - Local Suricata Detection Rules
# Provides high-fidelity network intrusion detection across major attack vectors
# ==============================================================================

# 1. Reconnaissance / Port Scanning
alert tcp any any -> $HOME_NET any (flags:S; msg:"SG-NIDS Reconnaissance TCP SYN Scan Detected"; threshold:type both, track by_src, count 20, seconds 5; classtype:attempted-recon; sid:2000001; rev:1;)
alert tcp any any -> $HOME_NET any (flags:FUP; msg:"SG-NIDS Reconnaissance Nmap XMAS Scan Detected"; classtype:attempted-recon; sid:2000002; rev:1;)
alert tcp any any -> $HOME_NET any (flags:0; msg:"SG-NIDS Reconnaissance NULL Scan Detected"; classtype:attempted-recon; sid:2000003; rev:1;)

# 2. Credential Access / Brute Force
alert tcp any any -> $HOME_NET 22 (flags:S; msg:"SG-NIDS SSH Brute Force Ingress Connection Burst"; threshold:type both, track by_src, count 6, seconds 10; classtype:attempted-admin; sid:2000010; rev:1;)
alert tcp any any -> $HOME_NET 80 (msg:"SG-NIDS HTTP Administrative Login Probing"; content:"POST"; http_method; content:"/admin/login"; http_uri; threshold:type both, track by_src, count 5, seconds 15; classtype:attempted-admin; sid:2000011; rev:1;)

# 3. Volumetric Denial of Service (DDoS)
alert udp any any -> $HOME_NET any (msg:"SG-NIDS Volumetric UDP Flood Anomaly"; threshold:type both, track by_dst, count 500, seconds 2; classtype:attempted-dos; sid:2000020; rev:1;)
alert tcp any any -> $HOME_NET any (flags:S; msg:"SG-NIDS Volumetric TCP SYN Flood Anomaly"; threshold:type both, track by_dst, count 1000, seconds 2; classtype:attempted-dos; sid:2000021; rev:1;)

# 4. Command & Control (C2) / Malware Activity
alert dns any any -> any any (msg:"SG-NIDS Suspicious High-Entropy Domain Query (Potential DGA/C2)"; content:"|00 01|"; nocase; threshold:type both, track by_src, count 30, seconds 10; classtype:bad-unknown; sid:2000030; rev:1;)
alert tls any any -> any any (msg:"SG-NIDS Suspicious Outbound TLS Handshake to Unclassified Endpoint"; flow:established,to_server; threshold:type both, track by_src, count 10, seconds 30; classtype:bad-unknown; sid:2000031; rev:1;)

# 5. Data Exfiltration
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"SG-NIDS High-Volume Outbound Data Exfiltration Spike"; flow:established,to_server; threshold:type both, track by_src, count 200, seconds 5; classtype:suspicious-filename-detect; sid:2000040; rev:1;)
